# ==============================================================================
# The Intelligence System — Configuración de Entorno (Producción / Local)
# ==============================================================================
# Copia este archivo a .env y configura tu OPENAI_API_KEY real:
#   cp .env.example .env

# --- Proveedor LLM y Embeddings ---
OPENAI_API_KEY=pon_aqui_tu_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- RAG y Base Vectorial (ChromaDB) ---
CHROMA_PERSIST_DIR=./storage/chroma
CHROMA_COLLECTION_NAME=intelligence_system_kb
KNOWLEDGE_BASE_DIR=./data/knowledge_base
RAG_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Persistencia de Conversaciones (LangGraph Checkpointer) ---
# Opciones soportadas: "sqlite" (por defecto, persiste en disco local) o "redis"
CHECKPOINTER_BACKEND=sqlite
SQLITE_CHECKPOINT_PATH=./storage/checkpoints.sqlite
ORDERS_DB_PATH=./storage/orders.sqlite
REDIS_URL=redis://localhost:6379/0

# --- Reglas del Grafo Multi-Agente (Supervisor) ---
MAX_VALIDATION_RETRIES=2
PROMPT_VERSION=intelligence-system-v1.0

# --- API FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
# Token opcional de API (si se deja vacío, permite acceso local directo para pruebas)
API_BEARER_TOKEN=

# --- Observabilidad (Arize Phoenix / OpenTelemetry & LangSmith opcional) ---
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=the-intelligence-system
PRICE_INPUT_USD_PER_MILLION=0.15
PRICE_OUTPUT_USD_PER_MILLION=0.60

# Opcional: LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=the-intelligence-system
